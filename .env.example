# 이 파일을 .env로 복사한 뒤 값을 채웁니다: cp .env.example .env

# 필수: 데이터 소스
FRED_API_KEY=
ECOS_API_KEY=

# 선택: AI 분석을 API 키로 쓸 때만, 쓰는 것만 주석을 풉니다
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# 선택: 유명 투자자(SEC 13F)와 스크리닝의 영업이익률 5년 평균(SEC 10-K)을 받을 때만.
# SEC가 요구하는 이름과 연락 이메일
# SEC_USER_AGENT="이름 이메일"

# 선택: 미국 종목 일봉(Alpaca)과 시가총액(Massive)을 공식 소스로 받을 때만.
# 없으면 Yahoo(yfinance)로 받습니다. 둘 다 무료 플랜 한도에 맞춰 요청합니다.
# Alpaca 무료 키(모의투자 계정): https://app.alpaca.markets/signup
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# Massive 무료 키: https://massive.com 에서 가입 후 대시보드의 API Keys
# MASSIVE_API_KEY=
