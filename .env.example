# 이 파일을 .env로 복사한 뒤 값을 채웁니다: cp .env.example .env

# 필수: 데이터 소스
FRED_API_KEY=
ECOS_API_KEY=

# 선택: AI 분석을 API 키로 쓸 때만, 쓰는 것만 주석을 풉니다
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# 선택: 유명 투자자(SEC 13F), ETF 총보수·구성(SEC N-CSR·N-PORT), 미국 종목 재무값(SEC)을 받을 때만.
# SEC가 요구하는 이름과 연락 이메일, 영문(ASCII)으로
# SEC_USER_AGENT="Hong Gildong hong@example.com"

# 선택: 미국 종목 일봉(Alpaca)을 공식 소스로 받을 때만.
# 없으면 Yahoo(yfinance)로 받습니다. 무료 플랜 한도에 맞춰 요청합니다.
# Alpaca 무료 키(모의투자 계정): https://app.alpaca.markets/signup
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# 선택: ETF 구성과 13F의 CUSIP → 티커 변환(OpenFIGI)을 빠르게 할 때만.
# 없으면 분당 20회·요청당 10개, 있으면 분당 200회·요청당 100개로 요청합니다.
# OpenFIGI 무료 키: https://www.openfigi.com/user/profile/api-key
# OPENFIGI_API_KEY=
